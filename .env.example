# Legal Redactor - Root Environment Configuration
# Copy to .env and adjust values for your environment

# ==========================================
# GENERAL
# ==========================================
COMPOSE_PROJECT_NAME=legal-redactor

# ==========================================
# BACKEND (also in backend/.env)
# ==========================================
DATABASE_URL=postgresql+asyncpg://legal:legal_pass@localhost:5432/legal_redactor
REDIS_URL=redis://localhost:6379/0
PRESIDIO_ANALYZER_URL=http://localhost:3000
PRESIDIO_ANONYMIZER_URL=http://localhost:3001
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=legal-redactor
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=legal-redactor
KEYCLOAK_CLIENT_ID=backend-api
KEYCLOAK_CLIENT_SECRET=your-client-secret
SECRET_KEY=your-super-secret-key-min-32-chars-long-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO

# ==========================================
# FRONTEND (also in frontend/.env)
# ==========================================
VITE_API_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=legal-redactor
VITE_KEYCLOAK_CLIENT_ID=frontend

# ==========================================
# KEYCLOAK
# ==========================================
KC_BOOTSTRAP_ADMIN_USER=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# ==========================================
# MINIO
# ==========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ==========================================
# POSTGRES
# ==========================================
POSTGRES_DB=legal_redactor
POSTGRES_USER=legal
POSTGRES_PASSWORD=legal_pass
