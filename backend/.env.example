# Legal Redactor Backend Configuration
# Copy to .env and adjust values

# Application
APP_NAME="Legal Redactor API"
DEBUG=true
SECRET_KEY=your-super-secret-key-min-32-chars-long-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Database
DATABASE_URL=postgresql+asyncpg://legal:legal_pass@localhost:5432/legal_redactor

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Presidio (PII Detection)
PRESIDIO_ANALYZER_URL=http://localhost:3000
PRESIDIO_ANONYMIZER_URL=http://localhost:3001

# MinIO / Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=legal-redactor
MINIO_SECURE=false

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=legal-redactor
KEYCLOAK_CLIENT_ID=backend-api
KEYCLOAK_CLIENT_SECRET=your-client-secret

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Logging
LOG_LEVEL=INFO

# File Upload
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=[".pdf",".png",".jpg",".jpeg",".tiff",".tif"]
